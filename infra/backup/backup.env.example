# Copy to /etc/rooman/backup.env on the host (mode 600, owned by root).
# Never commit the real file.

# Space-separated "container|database|user" entries. The values below match
# the current Books production compose project (-p roomanbooks) on CT103.
# Add core-db and bookings-db entries when those services are deployed.
DATABASES="roomanbooks-db-1|roomanbooks|roomanbooks"

# Docker volumes to archive (Books uploads live in the api_data volume).
VOLUMES="roomanbooks_api_data"

BACKUP_DIR=/var/backups/rooman
RETENTION_DAYS=14

# Off-site copy: set ONE of these. <BACKUP_TARGET> is still an open decision.
OFFSITE_RCLONE_REMOTE=
OFFSITE_RSYNC_TARGET=

# Optional dead-man's switch (e.g. a healthchecks.io URL), pinged on success.
HEALTHCHECK_URL=
