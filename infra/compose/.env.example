# Copy to infra/compose/.env (git-ignored) and fill in. Never commit real values.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# Hostnames become books.<DOMAIN>, id.<DOMAIN>, bookings.<DOMAIN>.
DOMAIN=localhost
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=80
GATEWAY_DASHBOARD_PORT=8088

# Books
BOOKS_DB_NAME=roomanbooks
BOOKS_DB_USER=roomanbooks
BOOKS_DB_PASSWORD=
BOOKS_SECRET_KEY=
BOOKS_ENVIRONMENT=development

# Core
CORE_DB_NAME=rooman_core
CORE_DB_USER=rooman_core
CORE_DB_PASSWORD=

# Bookings
BOOKINGS_DB_NAME=rooman_bookings
BOOKINGS_DB_USER=rooman_bookings
BOOKINGS_DB_PASSWORD=

# Event hub
NATS_USER=rooman
NATS_PASSWORD=

# Outbound email for Books (optional locally)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER_NAME=Rooman Books Accounts

# Optional host overrides (defaults are books./id./bookings.<DOMAIN>).
# Behind a TLS-terminating reverse proxy set PUBLIC_SCHEME=https and COOKIE_SECURE=true.
# CORE_HOST=
# BOOKS_HOST=
# BOOKINGS_HOST=
# PUBLIC_SCHEME=http
# COOKIE_SECURE=false
