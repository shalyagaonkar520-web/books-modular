# Copy to infra/core-db/.env on the database server (chmod 600). Never commit it.
# Generate each password with: openssl rand -base64 32 | tr -d '/+=' | cut -c1-32

# The server's PRIVATE address. PostgreSQL is published here only.
BIND_IP=10.0.0.20
PORT=5432

# Who may connect: the app server(s) running Core, in CIDR form.
# One server: 10.0.0.10/32. Several: a private subnet such as 10.0.0.0/24.
ALLOWED_CIDR=10.0.0.10/32

CORE_DB_NAME=rooman_core

# Superuser: administration only. No application ever uses it.
POSTGRES_PASSWORD=
# Owns the schema; used by Alembic migrations only.
CORE_OWNER_PASSWORD=
# Runtime user for the Core API: reads and writes rows, cannot change the schema.
CORE_APP_PASSWORD=

# Sizing (defaults suit a 2-4 GB server; shared_buffers ~25% of RAM)
MAX_CONNECTIONS=200
SHARED_BUFFERS=512MB

# Name on the TLS certificate (the private DNS name or IP clients use).
TLS_COMMON_NAME=core-db.internal
