{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.rooman.one/events/invoice.created.v1.schema.json",
  "title": "invoice.created v1",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "invoice.created"
    },
    "version": {
      "const": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invoice_id",
        "number",
        "customer_id",
        "date",
        "currency",
        "subtotal",
        "tax_total",
        "total"
      ],
      "properties": {
        "invoice_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "The record id inside the source app (any format)."
        },
        "number": {
          "type": "string"
        },
        "party_id": {
          "oneOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "customer_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "The record id inside the source app (any format)."
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "due_date": {
          "oneOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "subtotal": {
          "type": "string",
          "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
          "description": "Decimal as a string, never a float."
        },
        "tax_total": {
          "type": "string",
          "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
          "description": "Decimal as a string, never a float."
        },
        "total": {
          "type": "string",
          "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
          "description": "Decimal as a string, never a float."
        },
        "source_ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "e.g. appointment id when created from Bookings."
        },
        "lines": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "description",
              "quantity",
              "rate",
              "tax_rate"
            ],
            "properties": {
              "description": {
                "type": "string",
                "maxLength": 500
              },
              "plan_id": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 64,
                "description": "plan.upserted plan_id, if the line is a plan or add-on"
              },
              "quantity": {
                "type": "string",
                "pattern": "^\\d{1,9}(\\.\\d{1,3})?$"
              },
              "rate": {
                "type": "string",
                "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
                "description": "Decimal as a string, never a float."
              },
              "tax_rate": {
                "type": "string",
                "pattern": "^\\d{1,3}(\\.\\d{1,2})?$"
              },
              "hsn_sac": {
                "type": [
                  "string",
                  "null"
                ],
                "maxLength": 20
              }
            }
          }
        },
        "discount_total": {
          "type": "string",
          "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
          "description": "Decimal as a string, never a float."
        }
      }
    }
  },
  "x-sources": [
    "books",
    "billing"
  ]
}
