{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.rooman.one/events/subscription.cancelled.v1.schema.json",
  "title": "subscription.cancelled v1",
  "x-source": "billing",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "subscription.cancelled"
    },
    "version": {
      "const": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subscription_id",
        "party_id",
        "plan_id",
        "status",
        "current_period_end",
        "amount",
        "currency",
        "cancelled_at"
      ],
      "properties": {
        "subscription_id": {
          "type": "string",
          "format": "uuid"
        },
        "party_id": {
          "type": "string",
          "format": "uuid"
        },
        "plan_id": {
          "type": "string",
          "format": "uuid"
        },
        "status": {
          "enum": [
            "trialing",
            "active",
            "past_due",
            "cancelled"
          ]
        },
        "current_period_end": {
          "type": "string",
          "format": "date-time"
        },
        "amount": {
          "type": "string",
          "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
          "description": "Decimal as a string, never a float."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "cancelled_at": {
          "type": "string",
          "format": "date-time"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
