{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.rooman.one/events/plan.upserted.v1.schema.json",
  "title": "plan.upserted v1",
  "x-sources": [
    "billing"
  ],
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "plan.upserted"
    },
    "version": {
      "const": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan_id",
        "name",
        "price",
        "currency",
        "tax_rate",
        "is_active"
      ],
      "properties": {
        "plan_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "The record id inside the source app (any format)."
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "price": {
          "type": "string",
          "pattern": "^-?\\d{1,12}(\\.\\d{1,2})?$",
          "description": "Decimal as a string, never a float."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "tax_rate": {
          "type": "string",
          "pattern": "^\\d{1,3}(\\.\\d{1,2})?$"
        },
        "hsn_sac": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 20
        },
        "is_active": {
          "type": "boolean"
        }
      }
    }
  }
}
