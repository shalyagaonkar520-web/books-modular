{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.rooman.one/events/customer.created.v1.schema.json",
  "title": "customer.created v1",
  "allOf": [
    {
      "$ref": "envelope.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "customer.created"
    },
    "version": {
      "const": 1
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "display_name",
        "type"
      ],
      "properties": {
        "party_id": {
          "oneOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "app_local_id": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64,
          "description": "The record id inside the source app."
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "email": {
          "type": [
            "string",
            "null"
          ],
          "format": "email"
        },
        "phone": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 32
        },
        "type": {
          "type": "string",
          "enum": [
            "customer",
            "vendor",
            "both"
          ]
        },
        "company_name": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 200
        },
        "gstin": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 20
        },
        "billing_address": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1000
        }
      }
    }
  },
  "x-sources": [
    "books",
    "billing"
  ]
}
