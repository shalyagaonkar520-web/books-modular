# Copy to .env and fill in real values. Never commit .env.

# --- Required in production -------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ENVIRONMENT=production

# --- Database ---------------------------------------------------------------
# PostgreSQL (recommended for production)
POSTGRES_DB=roomanbooks
POSTGRES_USER=roomanbooks
POSTGRES_PASSWORD=
# The API builds this itself in docker-compose; set it directly when running standalone.
# DATABASE_URL=postgresql+psycopg://roomanbooks:password@localhost:5432/roomanbooks
# SQLite is the default for local development:
# DATABASE_URL=sqlite:///./data/roomanbooks.db

# --- HTTP / security --------------------------------------------------------
# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Set true when serving over HTTPS so the refresh cookie is marked Secure.
COOKIE_SECURE=false
# Set false to require administrators to invite every user.
ALLOW_PUBLIC_SIGNUP=true
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
LOGIN_RATE_LIMIT_PER_MINUTE=10

# --- Storage ----------------------------------------------------------------
DATA_DIR=./data
MAX_UPLOAD_SIZE_MB=25

# --- Runtime ----------------------------------------------------------------
API_PORT=8000
WEB_PORT=3000
WEB_CONCURRENCY=2
